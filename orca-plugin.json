{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "ktrz-monokai",
  "publisher": "sasagar",
  "name": "KTRZ Monokai for Orca",
  "version": "1.1.0",
  "execution": "data",
  "description": "A port of the KTRZ Monokai color scheme to Orca: flat Monokai themes (dark and light) with matching terminal themes and syntax colors.",
  "license": "MIT",
  "repository": "https://github.com/sasagar/orca-ktrz-monokai",
  "engines": {
    "orca": ">=1.4.245"
  },
  "contributes": {
    "themes": [
      {
        "id": "ktrz-monokai",
        "title": "KTRZ Monokai",
        "path": "themes/ktrz-monokai.json"
      },
      {
        "id": "ktrz-monokai-light",
        "title": "KTRZ Monokai Light",
        "path": "themes/ktrz-monokai-light.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "ktrz-monokai",
        "title": "KTRZ Monokai",
        "path": "terminal/ktrz-monokai.json"
      },
      {
        "id": "ktrz-monokai-light",
        "title": "KTRZ Monokai Light",
        "path": "terminal/ktrz-monokai-light.json"
      }
    ]
  },
  "capabilities": []
}
